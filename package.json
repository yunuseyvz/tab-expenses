{
  "name": "splitwise-lite",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "preview": "vite preview",
    "generate-routes": "tsr generate",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/seed.ts",
    "auth:schema": "tsx scripts/generate-auth-schema.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:auth": "sh scripts/smoke-auth.sh",
    "test:e2e": "sh scripts/e2e.sh",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm guard:auth",
    "serve": "sh scripts/dev-serve.sh",
    "stop": "sh scripts/dev-stop.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "guard:auth": "node scripts/check-auth-guards.mjs",
    "guard:vite-env": "node scripts/check-no-vite-env.mjs",
    "db:verify-constraints": "sh scripts/run-constraints.sh"
  },
  "dependencies": {
    "@base-ui/react": "1.6.0",
    "@react-email/components": "1.0.12",
    "@react-email/render": "2.1.0",
    "@tanstack/react-query": "5.104.0",
    "@tanstack/react-router": "1.170.40",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.168.59",
    "better-auth": "1.7.6",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.3",
    "lucide-react": "1.49.0",
    "motion": "13.4.6",
    "nitro": "3.0.0",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.10.1",
    "resend": "6.31.0",
    "sonner": "2.0.8",
    "srvx": "1.0.5",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.21",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/eslint-config": "0.4.0",
    "@tanstack/react-query-devtools": "5.104.0",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/router-cli": "1.167.39",
    "@tanstack/router-plugin": "1.168.41",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "drizzle-kit": "0.31.11",
    "eslint": "10.11.0",
    "jsdom": "30.1.1",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.1",
    "vitest": "5.0.3"
  }
}
