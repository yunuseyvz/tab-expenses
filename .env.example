# ─────────────────────────────────────────────────────────────
# Runtime secrets. Read from process.env at RUNTIME, never via
# VITE_* — Vite inlines VITE_* into the client bundle at build
# time. `pnpm guard:vite-env` enforces this in CI.
# ─────────────────────────────────────────────────────────────

# Postgres connection string. Inside compose this points at the `db` service.
DATABASE_URL=postgresql://app:app@localhost:5432/app

# Better Auth. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000

# So Better Auth's rate limiter reads the real client IP from
# X-Forwarded-For instead of the Traefik hop.
TRUSTED_PROXY_HEADERS=true

# ── Email ───────────────────────────────────────────────────
# Leave RESEND_API_KEY blank in dev: the app then talks to Mailpit
# on SMTP_HOST/SMTP_PORT instead. In prod set it and the app uses
# Resend over HTTPS.
RESEND_API_KEY=
EMAIL_FROM="Splitwise <noreply@example.com>"

# Mailpit (dev only)
SMTP_HOST=localhost
SMTP_PORT=1025

# ── Build-time public values (safe to inline) ───────────────
VITE_APP_NAME=Splitwise
