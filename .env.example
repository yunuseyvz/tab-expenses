# Copy to .env:  cp .env.example .env
#
# Everything the app and docker compose need lives here, so that
#   cp .env.example .env
# is enough to get a working local stack. The values below are DEVELOPMENT
# defaults — replace the secrets before this goes anywhere public.

# ── Database ───────────────────────────────────────────────────
# These four are what docker compose builds the postgres container from.
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app

# Host port the dev override publishes Postgres on. 5433 rather than 5432
# because a local Postgres is a common thing to already be running.
#
# ⚠ DB_PORT and the port inside DATABASE_URL must be the same number — that
#   string is what `pnpm dev` on the host connects with. Change both together.
DB_PORT=5433

# The app's own connection string.
#   • Running the app in compose  → compose overrides this with the `db` hostname.
#   • Running `pnpm dev` on the host → this is used, and must agree with the
#     values above, because that is the container listening on DB_PORT.
# The password here and POSTGRES_PASSWORD above must match.
DATABASE_URL=postgresql://app:app@localhost:5433/app

# ── Auth ───────────────────────────────────────────────────────
# Generate a real one for production:  openssl rand -base64 32
# Better Auth refuses to boot in production with anything under 32 characters.
BETTER_AUTH_SECRET=dev-only-secret-not-for-production-use-32chars
# The public origin, and it is also the allowed-Origin list. Use the SAME host
# string you will actually browse to:
#     BETTER_AUTH_URL=http://localhost:3000   → open http://localhost:3000
# Browsing to http://127.0.0.1:3000 instead fails with
#     "Invalid origin: http://127.0.0.1:3000"
# because the two are different origins as far as the browser and Better Auth
# are concerned, even though they reach the same server. (Vite also binds the
# dev server to the IPv6 loopback, so localhost is the one that works anyway.)
# In production this is your real HTTPS domain; a wrong value breaks sign-in.
BETTER_AUTH_URL=http://localhost:3000

# Extra hostnames that may also make authenticated requests, comma separated.
# Needed as soon as you reach the app by more than one name — the Tailscale
# hostname, a LAN IP, a tunnel — because BETTER_AUTH_URL is itself the
# allowed-Origin list. A name that is not listed here gets
# "Invalid origin: …" and cannot sign in.
#
#   BETTER_AUTH_TRUSTED_ORIGINS=kaya:3000,192.168.1.20:3000
#
# Note two consequences:
#   • A bare `host:port` is expanded with BETTER_AUTH_URL's scheme, so above
#     becomes http://kaya:3000 and http://192.168.1.20:3000.
#   • Session cookies are host-only, so each hostname has its own login.
#     Signing in on one does not sign you in on another.
#
# A cleaner answer for Tailscale is to serve it over HTTPS instead:
#     tailscale serve --bg 3000
# which gives a real certificate and one canonical origin.
BETTER_AUTH_TRUSTED_ORIGINS=

# Set to true when a reverse proxy (Traefik, Coolify) sits in front, so the
# rate limiter reads the real client IP from X-Forwarded-For.
# Leave false for plain local dev, or every request looks like it comes from
# the proxy and shares one rate-limit bucket.
TRUSTED_PROXY_HEADERS=false

# ── Email ──────────────────────────────────────────────────────
# Leave RESEND_API_KEY blank in dev: mail then goes to Mailpit instead.
# In production, set it — that is the only path that works without Mailpit.
RESEND_API_KEY=
EMAIL_FROM="Tally <noreply@example.com>"

# Mailpit (dev only) — its HTTP API port, not the SMTP one. The app POSTs to
# /api/v1/send rather than speaking SMTP.
MAILPIT_API_URL=http://localhost:8025

# ── Compose ────────────────────────────────────────────────────
# Host port the app is published on. Change if 3000 is taken.
APP_PORT=3000

# ── Build-time public values (safe to inline) ─────────────────
# The ONLY VITE_ variable this app reads. Vite inlines it into the client
# bundle at build time, so it must never be a secret.
VITE_APP_NAME=Tally
